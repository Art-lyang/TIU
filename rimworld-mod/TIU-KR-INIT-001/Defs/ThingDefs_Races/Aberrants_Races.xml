<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- ===================================================================
       TIU 이변체(ABERRANT) 공용 기반 정의
       EV-Σ 이후 확인되는 변이 개체. 인간형이 아니며 길들일 수 없음.
       텍스처는 바닐라 곤충형 그래픽을 재사용해 핑크 박스를 방지함.
  ==================================================================== -->
  <ThingDef Name="TIU_AberrantBase" ParentName="AnimalThingBase" Abstract="True">
    <statBases>
      <MoveSpeed>4.2</MoveSpeed>
      <MarketValue>250</MarketValue>
      <ComfyTemperatureMin>-40</ComfyTemperatureMin>
      <ComfyTemperatureMax>60</ComfyTemperatureMax>
      <ArmorRating_Blunt>0.10</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.20</ArmorRating_Sharp>
      <ToxicEnvironmentResistance>1</ToxicEnvironmentResistance>
    </statBases>
    <race>
      <fleshType>Insectoid</fleshType>
      <hasGenders>false</hasGenders>
      <body>QuadrupedAnimalWithPawsAndTail</body>
      <foodType>OmnivoreAnimal, CarnivoreAnimal</foodType>
      <intelligence>Animal</intelligence>
      <wildness>0.99</wildness>
      <trainability>None</trainability>
      <petness>0</petness>
      <nuzzleMtbHours>-1</nuzzleMtbHours>
      <predator>true</predator>
      <maxPreyBodySize>2.5</maxPreyBodySize>
      <manhunterOnDamageChance>0.85</manhunterOnDamageChance>
      <manhunterOnTameFailChance>1.0</manhunterOnTameFailChance>
      <lifeExpectancy>15</lifeExpectancy>
      <lifeStageAges>
        <li>
          <def>AnimalAdult</def>
          <minAge>0</minAge>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_BigBash_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_BigBash_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_BigBash_Miss</soundMeleeMiss>
    </race>
    <tradeability>None</tradeability>
  </ThingDef>

  <!-- SPEC-001 / CAUTION : 마네킹 -->
  <ThingDef ParentName="TIU_AberrantBase">
    <defName>TIU_Aberrant_Mannequin</defName>
    <label>마네킹</label>
    <description>SPEC-001. 사람의 형상을 닮은 초기 변이 표본. 외형 식별이 늦어지기 쉬워, 조우 시 접촉보다 거리 확보와 기록 대조가 우선된다.</description>
    <statBases>
      <MoveSpeed>4.6</MoveSpeed>
      <MarketValue>180</MarketValue>
    </statBases>
    <race>
      <baseBodySize>0.75</baseBodySize>
      <baseHealthScale>0.9</baseHealthScale>
    </race>
    <tools>
      <li>
        <label>claw</label>
        <capacities><li>Scratch</li></capacities>
        <power>9</power>
        <cooldownTime>2.0</cooldownTime>
        <linkedBodyPartsGroup>FrontLeftPaw</linkedBodyPartsGroup>
      </li>
      <li>
        <label>claw</label>
        <capacities><li>Scratch</li></capacities>
        <power>9</power>
        <cooldownTime>2.0</cooldownTime>
        <linkedBodyPartsGroup>FrontRightPaw</linkedBodyPartsGroup>
      </li>
      <li>
        <label>teeth</label>
        <capacities><li>Bite</li></capacities>
        <power>8</power>
        <cooldownTime>2.0</cooldownTime>
        <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
        <chanceFactor>0.7</chanceFactor>
      </li>
    </tools>
    <graphicData>
      <texPath>Things/Pawn/Animal/Megascarab/Megascarab</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>1.2</drawSize>
      <shadowData>
        <volume>(0.3, 0.2, 0.25)</volume>
      </shadowData>
    </graphicData>
  </ThingDef>

  <!-- SPEC-003 / DANGER : 브루드 드론 -->
  <ThingDef ParentName="TIU_AberrantBase">
    <defName>TIU_Aberrant_BroodDrone</defName>
    <label>브루드 드론</label>
    <description>SPEC-003. 군체 반응과 추격성이 강한 하위 개체. 단독보다 집단 조우 시 위험이 급상승하므로 이동 경로와 후방 차단 여부를 함께 기록한다.</description>
    <statBases>
      <MoveSpeed>5.4</MoveSpeed>
      <MarketValue>140</MarketValue>
    </statBases>
    <race>
      <baseBodySize>0.6</baseBodySize>
      <baseHealthScale>0.8</baseHealthScale>
    </race>
    <tools>
      <li>
        <label>mandibles</label>
        <capacities><li>Bite</li></capacities>
        <power>10</power>
        <cooldownTime>1.6</cooldownTime>
        <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
      </li>
      <li>
        <label>claw</label>
        <capacities><li>Scratch</li></capacities>
        <power>8</power>
        <cooldownTime>1.6</cooldownTime>
        <linkedBodyPartsGroup>FrontLeftPaw</linkedBodyPartsGroup>
      </li>
    </tools>
    <graphicData>
      <texPath>Things/Pawn/Animal/Spelopede/Spelopede</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>1.3</drawSize>
      <shadowData>
        <volume>(0.35, 0.2, 0.3)</volume>
      </shadowData>
    </graphicData>
  </ThingDef>

  <!-- SPEC-011 / HIGH : 쉘 토커 -->
  <ThingDef ParentName="TIU_AberrantBase">
    <defName>TIU_Aberrant_ShellTalker</defName>
    <label>쉘 토커</label>
    <description>SPEC-011. 음성 유인과 현장 지휘성이 관측되는 고위험 표본. 소리를 따라 이동하는 행위는 금지되며, 주변 하위 개체의 반응까지 함께 감시해야 한다.</description>
    <statBases>
      <MoveSpeed>3.8</MoveSpeed>
      <MarketValue>650</MarketValue>
      <ArmorRating_Blunt>0.25</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.40</ArmorRating_Sharp>
    </statBases>
    <race>
      <baseBodySize>1.45</baseBodySize>
      <baseHealthScale>2.7</baseHealthScale>
    </race>
    <tools>
      <li>
        <label>fangs</label>
        <capacities><li>Bite</li></capacities>
        <power>20</power>
        <cooldownTime>2.2</cooldownTime>
        <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
      </li>
      <li>
        <label>claw</label>
        <capacities><li>Scratch</li></capacities>
        <power>16</power>
        <cooldownTime>2.0</cooldownTime>
        <linkedBodyPartsGroup>FrontLeftPaw</linkedBodyPartsGroup>
      </li>
      <li>
        <label>claw</label>
        <capacities><li>Scratch</li></capacities>
        <power>16</power>
        <cooldownTime>2.0</cooldownTime>
        <linkedBodyPartsGroup>FrontRightPaw</linkedBodyPartsGroup>
      </li>
    </tools>
    <graphicData>
      <texPath>Things/Pawn/Animal/Megaspider/Megaspider</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>1.9</drawSize>
      <shadowData>
        <volume>(0.5, 0.3, 0.4)</volume>
      </shadowData>
    </graphicData>
  </ThingDef>

</Defs>
